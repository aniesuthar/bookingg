generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Vendor {
  id                      String                         @id @default(uuid()) @db.Uuid()
  pId                     Int                            @unique @default(autoincrement())
  name                    String
  bio                     String
  email                   String                         @unique
  phone                   String                         @unique
  phoneAlt                String?
  addressCity             String?
  addressPinCode          Int?
  addressState            String?
  addressStreet           String?
  aggregatedAppointments  Int                            @default(0)
  aggregatedRating        Float                          @default(4)
  canUsePlatform          Boolean                        @default(true)
  blockingReason          String?
  coverPhoto              String?
  logo                    String?
  maxBookingWindow        Int?
  minBookingWindow        Int?
  googleMapUrl            String?
  slug                    String
  startYear               Int?
  showBusinessDetails     Boolean                        @default(false)
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  appointments            Appointment[]
  providers               Provider[]
  schedules               Schedule[]                     @relation("VendorSchedules")
  services                Service[]
  vendorAdminId           String                         @unique @db.Uuid()
  vendorAdmin             User                    @relation(fields: [vendorAdminId], references: [id])
  bank                    VendorBank?
  design                  VendorDesign?
  notificationPreferences VendorNotificationPreference[]
  payments                VendorPayment[]
  socialLinks             VendorSocialLink[]
}

model Schedule {
  id         Int          @id @default(autoincrement())
  type       ScheduleType
  vendorId   String       @db.Uuid
  providerId String?      @db.Uuid
  day        Day?
  startDate  DateTime?
  endDate    DateTime?
  isHoliday  Boolean
  provider   Provider?    @relation("ProviderSchedules", fields: [providerId], references: [id])
  vendor     Vendor       @relation("VendorSchedules", fields: [vendorId], references: [id])
  slots      Slot[]

  @@index([vendorId, type, day])
  @@index([providerId, type, day])
}

model Slot {
  id         Int      @id @default(autoincrement())
  scheduleId Int
  start      DateTime
  end        DateTime
  schedule   Schedule @relation(fields: [scheduleId], references: [id])
}

model VendorNotificationPreference {
  id       Int     @id @default(autoincrement())
  vendorId String  @db.Uuid()
  channel  Channel
  isAllowed Boolean
  destination     String
  vendor   Vendor  @relation(fields: [vendorId], references: [id])
}

model Appointment {
  id                 String             @id @default(uuid()) @db.Uuid
  amount             Float
  bankRef            String
  cancellationReason String?
  createdAt          DateTime           @default(now())
  dateTime           DateTime
  easebuzzId         String
  formFields         Json
  user_name          String
  user_age           Int
  user_gender        Gender
  user_phone         String
  user_comment       String
  guestCount         Int
  isRescheduled      Boolean
  paymentStatus      String
  pId                Int                @unique @default(autoincrement())
  providerId         String             @db.Uuid
  refundStatus       String
  serviceId          String             @db.Uuid
  status             String
  txnId              String
  updatedAt          DateTime           @updatedAt
  userId             String             @db.Uuid
  vendorId           String             @db.Uuid
  provider           Provider           @relation(fields: [providerId], references: [id])
  service            Service            @relation(fields: [serviceId], references: [id])
  user               FrontUser          @relation(fields: [userId], references: [id])
  vendor             Vendor             @relation(fields: [vendorId], references: [id])
  refund             AppointmentRefund?
  transaction        Transaction?
}

model AppointmentRefund {
  id            Int         @id @default(autoincrement())
  amount        Float
  refundDate    DateTime
  appointmentId String      @unique @db.Uuid()
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
}

model Service {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  vendorId         String        @db.Uuid
  appointmentPrice Int
  bookingPrice     Int
  description      String
  duration         Int
  image            String
  isActive         Boolean
  pId              Int           @unique @default(autoincrement())
  appointments     Appointment[]
  questions        Question[]
  Vendor           Vendor        @relation(fields: [vendorId], references: [id])
  providers        Provider[]    @relation("ProviderToService")
}

model Question {
  id          Int     @id @default(autoincrement())
  label       String
  placeHolder String
  required    Boolean
  type        String
  serviceId   String  @db.Uuid()
  service     Service @relation(fields: [serviceId], references: [id])
}

model Transaction {
  id             String      @id @default(uuid()) @db.Uuid
  amount         Float
  date           DateTime
  appointmentId  String      @unique @db.Uuid
  bankRefNum     String
  cardType       String
  easepayid      String
  error          String
  errorMessage   String
  issuingBank    String
  netAmountDebit String
  status         String
  txnId          String
  userId         String      @db.Uuid
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  appointment    Appointment @relation(fields: [appointmentId], references: [id])
  user           FrontUser        @relation(fields: [userId], references: [id])
}

model FrontUser {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  email        String        @unique
  phone        String        @unique
  appointments Appointment[]
  transactions Transaction[]
}

model VendorPayment {
  id       String @id @default(uuid()) @db.Uuid
  vendorId String @db.Uuid
  vendor   Vendor @relation(fields: [vendorId], references: [id])
}

model Provider {
  id                        String               @id @default(uuid()) @db.Uuid
  vendorId                  String               @db.Uuid
  name                      String
  pId                       Int                  @unique @default(autoincrement())
  slug                      String
  aggregatedAppointments    Int                  @default(0)
  aggregatedRating          Float                @default(4)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  scheduleDefaultHoursEnd   Int
  scheduleDefaultHoursStart Int
  appointments              Appointment[]
  vendor                    Vendor               @relation(fields: [vendorId], references: [id])
  specialties               ProviderSpeciality[]
  schedules                 Schedule[]           @relation("ProviderSchedules")
  services                  Service[]            @relation("ProviderToService")
}

model ProviderSpeciality {
  id         Int      @id @default(autoincrement())
  providerId String   @db.Uuid
  title      String
  provider   Provider @relation(fields: [providerId], references: [id])
}

model VendorSocialLink {
  id       String          @id @default(uuid()) @db.Uuid
  vendorId String          @db.Uuid
  platform SocialPlatforms
  url      String
  vendor   Vendor          @relation(fields: [vendorId], references: [id])

  @@unique([platform, url])
}

model VendorBank {
  id            String @id @default(uuid()) @db.Uuid
  vendorId      String @unique @db.Uuid
  accountNumber String
  bankName      String
  holderName    String
  ifsc          String
  vendor        Vendor @relation(fields: [vendorId], references: [id])
}

model VendorDesign {
  id              String @id @default(uuid()) @db.Uuid
  vendorId        String @unique @db.Uuid
  accentColor     String
  backgroundColor String
  font            String
  textColor       String
  vendor          Vendor @relation(fields: [vendorId], references: [id])
}

model User {
  id                       String                    @id @default(uuid()) @db.Uuid
  name                     String
  email                    String                    @unique
  isBlocked                Boolean                   @default(false)
  blockingReason           String?                   @default("")
  vendor                   Vendor?
  emailVerified            DateTime?
  image                    String?
  password                 String?
  accounts                 Account[]
  sessions                 Session[]
  Authenticator            Authenticator[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @default(now()) @updatedAt

}

model Account {
  userId            String @db.Uuid
  type              String 
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}
 
model Session {
  sessionToken String   @unique
  userId       String @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}
 
// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String @db.Uuid
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([userId, credentialID])
}
enum ScheduleType {
  WEEKLY
  FLEXIBLE
}

enum Channel {
  WH
  PH
  EM
}

enum Gender {
  Male
  Female
}

enum Day {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

enum SocialPlatforms {
  FB
  INSTA
}
